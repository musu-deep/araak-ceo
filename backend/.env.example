# Core databases
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/araak_ceo
USE_MONGO=false
MONGO_URL=mongodb://localhost:27017
DB_NAME=arak_executive_platform

# Authentication and browser access
JWT_SECRET=replace-with-a-strong-random-secret
# Add the exact production URL of ARAAK Marketing & Tenders before deployment.
CORS_ORIGINS=https://ceo-office-platform.onrender.com,https://your-marketing-domain.example,http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Marketing & tenders central storage in CEO OFFICE PostgreSQL
MARKETING_MAX_FILES=5
MARKETING_MAX_FILE_SIZE=3145728

# Odoo Online adapter
# Keep disabled unless the Odoo deployment/plan exposes the supported external API.
# When API access is available, use a dedicated integration account/key stored on Render only.
ODOO_ENABLED=false
ODOO_URL=https://your-company.odoo.com
ODOO_DATABASE=
ODOO_USERNAME=
ODOO_API_KEY=
ODOO_PROTOCOL=auto
ODOO_TIMEOUT=20
ODOO_READ_ONLY=true

# Optional AI/voice integrations
EMERGENT_LLM_KEY=
