# Core databases
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/araak_ceo
USE_MONGO=false
MONGO_URL=mongodb://localhost:27017
DB_NAME=arak_executive_platform

# Authentication and browser access
JWT_SECRET=replace-with-a-strong-random-secret
CORS_ORIGINS=https://ceo-office-platform.onrender.com,https://araak-marketing.vercel.app,http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Odoo enterprise integration
ODOO_ENABLED=false
ODOO_URL=https://company.odoo.com
ODOO_DATABASE=database_name
ODOO_USERNAME=integration@company.com
ODOO_API_KEY=
ODOO_PROTOCOL=auto
ODOO_TIMEOUT=20
# Keep true during validation. Set false only when opportunity/tender write-back is approved.
ODOO_READ_ONLY=true
ODOO_MARKETING_MODEL=project.project
ODOO_MARKETING_MAX_FILES=5
ODOO_MARKETING_MAX_FILE_SIZE=3145728

# Optional AI/voice integrations
EMERGENT_LLM_KEY=
