# Core databases
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/araak_ceo
USE_MONGO=false
MONGO_URL=mongodb://localhost:27017
DB_NAME=arak_executive_platform

# Authentication and browser access
JWT_SECRET=replace-with-a-strong-random-secret
# Add the exact production URL of ARAAK Marketing & Tenders before deployment.
CORS_ORIGINS=https://ceo-office-platform.onrender.com,https://araak-marketing.vercel.app,http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Marketing & tenders central storage in CEO OFFICE PostgreSQL
MARKETING_MAX_FILES=5
MARKETING_MAX_FILE_SIZE=3145728

# Odoo Online adapter
# Current Standard subscription does not expose the external API required by this connector.
# Keep disabled. When the subscription is upgraded to Custom (or another API-enabled deployment),
# add a dedicated integration user/key on Render only and then set ODOO_ENABLED=true.
ODOO_ENABLED=false
ODOO_URL=https://araakceo.odoo.com
ODOO_DATABASE=
ODOO_USERNAME=
ODOO_API_KEY=
ODOO_PROTOCOL=auto
ODOO_TIMEOUT=20
ODOO_READ_ONLY=true

# Optional AI/voice integrations
EMERGENT_LLM_KEY=
